#!/usr/bin/env python3
"""
YouTube Channel Video Data Extractor

This script extracts all video data from a YouTube channel using the YouTube Data API v3
and saves them to a CSV file with title, date, and URL columns.

Requirements:
- google-api-python-client library: pip install google-api-python-client
- YouTube Data API v3 key (get from Google Cloud Console)

Usage:
python youtube_extractor.py <channel_url> <output_file.csv>
"""

import sys
import re
import os
import csv
from datetime import datetime
from googleapiclient.discovery import build
from googleapiclient.errors import HttpError

# You need to set your YouTube Data API key here
# Get it from: https://console.cloud.google.com/apis/credentials
API_KEY = "AIzaSyD_3CZkrmBGf5RyqQG8Vuf-dk8H9gIOA5A"


def extract_channel_id(channel_url):
    """Extract channel ID from various YouTube channel URL formats."""
    patterns = [
        r'youtube\.com/channel/([a-zA-Z0-9_-]+)',
        r'youtube\.com/c/([a-zA-Z0-9_-]+)',
        r'youtube\.com/user/([a-zA-Z0-9_-]+)',
        r'youtube\.com/@([a-zA-Z0-9_.-]+)',
        r'youtube\.com/([a-zA-Z0-9_-]+)/?$'
    ]

    for pattern in patterns:
        match = re.search(pattern, channel_url)
        if match:
            return match.group(1), 'channel' if 'channel/' in pattern else 'handle'

    raise ValueError("Invalid YouTube channel URL format")


def get_channel_id_from_handle(youtube, handle):
    """Convert channel handle/username to channel ID."""
    try:
        # Try as custom URL/handle first
        request = youtube.search().list(
            part="snippet",
            q=handle,
            type="channel",
            maxResults=1
        )
        response = request.execute()

        if response['items']:
            return response['items'][0]['snippet']['channelId']

        # Try as username
        request = youtube.channels().list(
            part="id",
            forUsername=handle
        )
        response = request.execute()

        if response['items']:
            return response['items'][0]['id']

    except HttpError:
        pass

    raise ValueError(f"Could not find channel with handle/username: {handle}")


def get_all_video_data(youtube, channel_id):
    """Get all video data from a channel in chronological order (most recent first)."""
    video_data = []

    try:
        # Get the uploads playlist ID
        request = youtube.channels().list(
            part="contentDetails",
            id=channel_id
        )
        response = request.execute()

        if not response['items']:
            raise ValueError("Channel not found")

        uploads_playlist_id = response['items'][0]['contentDetails']['relatedPlaylists']['uploads']

        # Get all videos from the uploads playlist
        next_page_token = None

        while True:
            request = youtube.playlistItems().list(
                part="contentDetails,snippet",
                playlistId=uploads_playlist_id,
                maxResults=50,
                pageToken=next_page_token
            )
            response = request.execute()

            # Extract video data with title, publish dates, and URLs
            for item in response['items']:
                video_id = item['contentDetails']['videoId']
                video_url = f"https://www.youtube.com/watch?v={video_id}"
                title = item['snippet']['title']
                publish_date = item['snippet']['publishedAt']

                # Convert ISO format date to readable format
                date_obj = datetime.fromisoformat(publish_date.replace('Z', '+00:00'))
                formatted_date = date_obj.strftime('%Y-%m-%d %H:%M:%S')

                video_data.append({
                    'title': title,
                    'date': formatted_date,
                    'url': video_url,
                    'published_at': publish_date  # Keep original for sorting
                })

            # Check if there are more pages
            next_page_token = response.get('nextPageToken')
            if not next_page_token:
                break

            print(f"Retrieved {len(video_data)} videos so far...")

    except HttpError as e:
        raise Exception(f"An HTTP error occurred: {e}")

    # Sort by publish date (most recent first)
    video_data.sort(key=lambda x: x['published_at'], reverse=True)
    return video_data


def main():
    if len(sys.argv) != 3:
        print("Usage: python youtube_extractor.py <channel_url> <output_file.csv>")
        print("\nExample:")
        print("python youtube_extractor.py https://www.youtube.com/@channelname videos.csv")
        print("python youtube_extractor.py https://www.youtube.com/channel/UC_x5XG1OV2P6uZZ5FSM9Ttw videos.csv")
        sys.exit(1)

    channel_url = sys.argv[1]
    output_file = sys.argv[2]

    if not API_KEY or API_KEY == "YOUR_API_KEY_HERE":
        print("Error: Please set your YouTube Data API key in the API_KEY variable")
        print("Get your API key from: https://console.cloud.google.com/apis/credentials")
        sys.exit(1)

    try:
        # Initialize YouTube API client
        youtube = build('youtube', 'v3', developerKey=API_KEY)

        print(f"Processing channel URL: {channel_url}")

        # Extract channel identifier
        channel_identifier, id_type = extract_channel_id(channel_url)

        # Get actual channel ID if needed
        if id_type == 'channel':
            channel_id = channel_identifier
        else:
            print(f"Converting handle/username '{channel_identifier}' to channel ID...")
            channel_id = get_channel_id_from_handle(youtube, channel_identifier)

        print(f"Channel ID: {channel_id}")
        print("Fetching video data...")

        # Get all video data
        video_data = get_all_video_data(youtube, channel_id)

        print(f"Found {len(video_data)} videos")
        print("Sorting videos by publish date (most recent first)...")

        # Save data to CSV file
        with open(output_file, 'w', newline='', encoding='utf-8') as csvfile:
            fieldnames = ['Title', 'Date', 'URL']
            writer = csv.DictWriter(csvfile, fieldnames=fieldnames, quoting=csv.QUOTE_ALL)

            # Write header
            writer.writeheader()

            # Write video data
            for video in video_data:
                # Clean title to handle special characters
                clean_title = video['title'].replace('\n', ' ').replace('\r', ' ').strip()

                writer.writerow({
                    'Title': clean_title,
                    'Date': video['date'],
                    'URL': video['url']
                })

        print(f"Successfully wrote {len(video_data)} videos to CSV file")

        print(f"Video data saved to CSV file: {output_file}")

    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"An error occurred: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()